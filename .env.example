# OpenAI API key (required)
LLM_API_KEY=
# Model name (required), e.g. gpt-5.4
LLM_MODEL=
# Optional: only for an OpenAI-compatible gateway or proxy; empty uses api.openai.com
LLM_BASE_URL=
# Optional per-agent model overrides (fall back to LLM_MODEL)
ORCHESTRATOR_MODEL=
SYNTHESIS_MODEL=
# Optional: defaults to the effective synthesis model
VERIFICATION_MODEL=
# Optional, verification only: none|minimal|low|medium|high|xhigh
VERIFICATION_REASONING_EFFORT=
# Optional: chat (default) or responses; models like gpt-6.1-terra need responses
VERIFICATION_API=chat

# Max parallel LLM calls across all agents
LLM_MAX_CONCURRENCY=4
# Email for the OpenAlex polite pool
OPENALEX_MAILTO=

# Optional Semantic Scholar key; anonymous access uses shared limits
SEMANTIC_SCHOLAR_API_KEY=
