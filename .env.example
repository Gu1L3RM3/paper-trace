# Any server speaking the chat/completions protocol with function calling:
# Ollama, vLLM, LM Studio, OpenRouter, Groq, a company gateway, a hosted API...
LLM_BASE_URL=http://localhost:11434/v1
# Model name exactly as the server expects it (required)
LLM_MODEL=
# Optional: keyless local servers need none
LLM_API_KEY=
# Optional: "package.module:function" to plug in an adapter for an API that does not speak
# chat/completions (see README). Default is the generic HTTP client.
LLM_PROVIDER=chat_completions
# Optional per-agent model overrides (fall back to LLM_MODEL)
ORCHESTRATOR_MODEL=
SYNTHESIS_MODEL=
# Optional: defaults to the effective synthesis model
VERIFICATION_MODEL=
# Max parallel LLM calls across all agents
LLM_MAX_CONCURRENCY=4
# Email for the OpenAlex polite pool
OPENALEX_MAILTO=
