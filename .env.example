# LLM provider: "anthropic", "openai_compatible" (OpenAI, OpenRouter, Groq, Ollama, vLLM...)
# or "your_package.module:build_function" for any other API (see README)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
# Only for openai_compatible providers, e.g. http://localhost:11434/v1
LLM_BASE_URL=
# Optional per-agent model overrides (fall back to LLM_MODEL)
ORCHESTRATOR_MODEL=
SYNTHESIS_MODEL=
# Max parallel LLM calls across all agents
LLM_MAX_CONCURRENCY=4
# Email for the OpenAlex polite pool
OPENALEX_MAILTO=
